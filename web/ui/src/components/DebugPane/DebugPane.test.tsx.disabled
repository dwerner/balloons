import React from 'react';
import { render, screen, fireEvent } from '@testing-library/react';
import { DebugPane } from './DebugPane';
import type { LogEntry } from './DebugPaneTypes';

// Mock log entries for testing
const mockEntries: LogEntry[] = [
  {
    seq: 1,
    level: 'info',
    message: 'Application started',
    timestamp: '10:00:00.000',
    category: 'process',
  },
  {
    seq: 2,
    level: 'debug',
    message: 'Loading configuration',
    timestamp: '10:00:00.100',
    category: 'config',
    details: { file: 'config.json' },
  },
  {
    seq: 3,
    level: 'warning',
    message: 'Configuration key deprecated',
    timestamp: '10:00:00.200',
    category: 'config',
  },
  {
    seq: 4,
    level: 'error',
    message: 'Failed to connect to database',
    timestamp: '10:00:00.300',
    category: 'database',
    details: { host: 'localhost', port: 5432 },
  },
  {
    seq: 5,
    level: 'trace',
    message: 'Scroll event received',
    timestamp: '10:00:00.400',
  },
  {
    seq: 6,
    level: 'perf',
    message: 'render_chat_log: 45.2ms',
    timestamp: '10:00:00.500',
    category: 'perf',
    details: { elapsed_ms: 45.2 },
  },
];

describe('DebugPane', () => {
  it('renders in collapsed state by default', () => {
    render(<DebugPane entries={mockEntries} />);

    // Should show header
    expect(screen.getByText('Debug Log')).toBeInTheDocument();

    // Should show error count badge
    expect(screen.getByText('1')).toBeInTheDocument();

    // Log entries should not be visible
    expect(screen.queryByText('Application started')).not.toBeInTheDocument();
  });

  it('expands when header is clicked', () => {
    render(<DebugPane entries={mockEntries} initialCollapsed={true} />);

    // Click header to expand
    fireEvent.click(screen.getByRole('button', { name: /debug log/i }));

    // Log entries should now be visible (filtered by default min level 'debug')
    expect(screen.getByText(/Application started/)).toBeInTheDocument();
    expect(screen.getByText(/Loading configuration/)).toBeInTheDocument();
    expect(screen.getByText(/Failed to connect to database/)).toBeInTheDocument();
  });

  it('renders in expanded state when initialCollapsed is false', () => {
    render(<DebugPane entries={mockEntries} initialCollapsed={false} />);

    // Log entries should be visible
    expect(screen.getByText(/Application started/)).toBeInTheDocument();
  });

  it('displays error count in badge', () => {
    render(<DebugPane entries={mockEntries} />);

    const badge = screen.getByLabelText('1 errors');
    expect(badge).toBeInTheDocument();
    expect(badge).toHaveTextContent('1');
  });

  it('shows no badge when there are no errors', () => {
    const noErrorEntries = mockEntries.filter((e) => e.level !== 'error');
    render(<DebugPane entries={noErrorEntries} />);

    expect(screen.queryByLabelText(/errors/)).not.toBeInTheDocument();
  });

  it('filters entries by log level', () => {
    render(<DebugPane entries={mockEntries} initialCollapsed={false} />);

    // Default level is 'debug', so trace should be filtered out
    expect(screen.queryByText(/Scroll event received/)).not.toBeInTheDocument();

    // Click on [T] to show trace level
    fireEvent.click(screen.getByTitle('Filter to trace and above'));

    // Now trace should be visible
    expect(screen.getByText(/Scroll event received/)).toBeInTheDocument();
  });

  it('filters to higher levels when clicking level buttons', () => {
    render(<DebugPane entries={mockEntries} initialCollapsed={false} />);

    // Click on [W] to show only warning and above
    fireEvent.click(screen.getByTitle('Filter to warning and above'));

    // Warning and error should be visible
    expect(screen.getByText(/Configuration key deprecated/)).toBeInTheDocument();
    expect(screen.getByText(/Failed to connect to database/)).toBeInTheDocument();

    // Info and debug should be filtered out
    expect(screen.queryByText(/Application started/)).not.toBeInTheDocument();
    expect(screen.queryByText(/Loading configuration/)).not.toBeInTheDocument();
  });

  it('calls onLogLineCopy when Ctrl+clicking an entry', () => {
    const onLogLineCopy = jest.fn();
    render(
      <DebugPane
        entries={mockEntries}
        initialCollapsed={false}
        onLogLineCopy={onLogLineCopy}
      />
    );

    // Find and Ctrl+click on the info entry
    const infoEntry = screen.getByText(/Application started/).closest('.debug-pane__entry');
    expect(infoEntry).toBeInTheDocument();

    fireEvent.click(infoEntry!, { ctrlKey: true });

    expect(onLogLineCopy).toHaveBeenCalledWith(
      expect.stringContaining('Application started'),
      expect.objectContaining({ seq: 1, level: 'info' })
    );
  });

  it('calls onClear when clear button is clicked', () => {
    const onClear = jest.fn();
    render(
      <DebugPane
        entries={mockEntries}
        initialCollapsed={false}
        onClear={onClear}
      />
    );

    fireEvent.click(screen.getByTitle('Clear log entries'));

    expect(onClear).toHaveBeenCalled();
  });

  it('shows empty state when no entries match filter', () => {
    const infoOnlyEntries: LogEntry[] = [
      {
        seq: 1,
        level: 'info',
        message: 'Only info message',
        timestamp: '10:00:00.000',
      },
    ];

    render(
      <DebugPane entries={infoOnlyEntries} initialCollapsed={false} />
    );

    // Click on [E] to show only errors
    fireEvent.click(screen.getByTitle('Filter to error and above'));

    // Should show empty state
    expect(screen.getByText('No log entries')).toBeInTheDocument();
  });

  it('displays entry details when present', () => {
    render(<DebugPane entries={mockEntries} initialCollapsed={false} />);

    // The details should be formatted and displayed
    expect(screen.getByText(/file=config\.json/)).toBeInTheDocument();
  });

  it('displays category when present', () => {
    render(<DebugPane entries={mockEntries} initialCollapsed={false} />);

    // Categories should be displayed
    expect(screen.getByText('process:')).toBeInTheDocument();
    expect(screen.getByText('config:')).toBeInTheDocument();
  });

  it('calls onMinLevelChange when level changes', () => {
    const onMinLevelChange = jest.fn();
    render(
      <DebugPane
        entries={mockEntries}
        initialCollapsed={false}
        onMinLevelChange={onMinLevelChange}
      />
    );

    fireEvent.click(screen.getByTitle('Filter to warning and above'));

    expect(onMinLevelChange).toHaveBeenCalledWith('warning');
  });

  it('respects initialMinLevel prop', () => {
    render(
      <DebugPane
        entries={mockEntries}
        initialCollapsed={false}
        initialMinLevel="error"
      />
    );

    // Only error should be visible
    expect(screen.getByText(/Failed to connect to database/)).toBeInTheDocument();
    expect(screen.queryByText(/Application started/)).not.toBeInTheDocument();
  });

  it('truncates long messages', () => {
    const longMessageEntry: LogEntry[] = [
      {
        seq: 1,
        level: 'info',
        message: 'A'.repeat(150),
        timestamp: '10:00:00.000',
      },
    ];

    render(<DebugPane entries={longMessageEntry} initialCollapsed={false} />);

    // Message should be truncated with ellipsis
    const truncated = screen.getByText(/^A{97}\.\.\./);
    expect(truncated).toBeInTheDocument();
  });

  it('collapses when clicking header in expanded state', () => {
    render(<DebugPane entries={mockEntries} initialCollapsed={false} />);

    // Should show entries initially
    expect(screen.getByText(/Application started/)).toBeInTheDocument();

    // Click header to collapse
    fireEvent.click(screen.getByRole('button', { name: /debug log/i }));

    // Entries should no longer be visible
    expect(screen.queryByText('Application started')).not.toBeInTheDocument();
  });

  it('supports keyboard navigation on header', () => {
    render(<DebugPane entries={mockEntries} initialCollapsed={true} />);

    const header = screen.getByRole('button', { name: /debug log/i });

    // Press Enter to expand
    fireEvent.keyDown(header, { key: 'Enter' });

    // Should now show entries
    expect(screen.getByText(/Application started/)).toBeInTheDocument();

    // Press Space to collapse
    fireEvent.keyDown(header, { key: ' ' });

    // Should hide entries
    expect(screen.queryByText('Application started')).not.toBeInTheDocument();
  });
});

describe('DebugPane auto-expand on error', () => {
  it('auto-expands when a new error is added', () => {
    const initialEntries: LogEntry[] = [
      {
        seq: 1,
        level: 'info',
        message: 'Initial entry',
        timestamp: '10:00:00.000',
      },
    ];

    const { rerender } = render(
      <DebugPane entries={initialEntries} initialCollapsed={true} />
    );

    // Should be collapsed
    expect(screen.queryByText('Initial entry')).not.toBeInTheDocument();

    // Add an error entry
    const entriesWithError: LogEntry[] = [
      ...initialEntries,
      {
        seq: 2,
        level: 'error',
        message: 'New error occurred',
        timestamp: '10:00:00.100',
      },
    ];

    rerender(<DebugPane entries={entriesWithError} initialCollapsed={true} />);

    // Should auto-expand (entries become visible)
    expect(screen.getByText(/New error occurred/)).toBeInTheDocument();
  });

  it('does not auto-expand when autoExpandOnError is false', () => {
    const initialEntries: LogEntry[] = [
      {
        seq: 1,
        level: 'info',
        message: 'Initial entry',
        timestamp: '10:00:00.000',
      },
    ];

    const { rerender } = render(
      <DebugPane
        entries={initialEntries}
        initialCollapsed={true}
        autoExpandOnError={false}
      />
    );

    // Add an error entry
    const entriesWithError: LogEntry[] = [
      ...initialEntries,
      {
        seq: 2,
        level: 'error',
        message: 'New error occurred',
        timestamp: '10:00:00.100',
      },
    ];

    rerender(
      <DebugPane
        entries={entriesWithError}
        initialCollapsed={true}
        autoExpandOnError={false}
      />
    );

    // Should stay collapsed
    expect(screen.queryByText('New error occurred')).not.toBeInTheDocument();
  });

  it('has red border when auto-expanded', () => {
    const initialEntries: LogEntry[] = [];

    const { rerender, container } = render(
      <DebugPane entries={initialEntries} initialCollapsed={true} />
    );

    // Add an error entry
    const entriesWithError: LogEntry[] = [
      {
        seq: 1,
        level: 'error',
        message: 'Error occurred',
        timestamp: '10:00:00.000',
      },
    ];

    rerender(<DebugPane entries={entriesWithError} initialCollapsed={true} />);

    // Should have auto-expanded class
    expect(container.querySelector('.debug-pane--auto-expanded')).toBeInTheDocument();
  });
});
